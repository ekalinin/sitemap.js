{
  "name": "sitemap",
  "version": "10.0.0",
  "description": "Sitemap-generating lib/cli",
  "keywords": [
    "sitemap",
    "sitemap.xml"
  ],
  "homepage": "https://github.com/ekalinin/sitemap.js#readme",
  "bugs": {
    "url": "https://github.com/ekalinin/sitemap.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekalinin/sitemap.js.git"
  },
  "license": "MIT",
  "author": "Eugene Kalinin <e.v.kalinin@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./dist/cli.js",
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"{lib,tests}/**/*.ts\" ./cli.ts",
    "lint:fix": "eslint --fix \"{lib,tests}/**/*.ts\" ./cli.ts",
    "prepare": "husky",
    "prepublishOnly": "rm -rf dist && npm run build && npm run test",
    "prettier": "npx prettier --check \"{lib,tests}/**/*.ts\" ./cli.ts",
    "prettier:fix": "npx prettier --write \"{lib,tests}/**/*.ts\" ./cli.ts",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.ts",
    "test:coverage": "npm run build && node --experimental-strip-types --experimental-test-coverage --test-coverage-branches=80 --test-coverage-functions=90 --test-coverage-lines=90 --test tests/*.test.ts",
    "test:full": "npm run lint && npm run test:coverage && npm run test:xmllint",
    "test:perf": "node ./tests/perf.mjs",
    "test:schema": "node ./tests/xmllint-schema.mjs",
    "test:typecheck": "tsc --noEmit",
    "test:xmllint": "node ./tests/xmllint-schema.mjs --skip-if-missing"
  },
  "lint-staged": {
    "package.json": [
      "sort-package-json"
    ],
    "{lib,tests}/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@types/node": "^22.0.0 || ^24.0.0 || ^26.0.0",
    "@types/sax": "^1.2.1",
    "sax": "^1.4.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@types/memorystream": "^0.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^17.13.0",
    "husky": "^9.0.11",
    "lint-staged": "^17.6.0",
    "memorystream": "^0.3.1",
    "prettier": "^3.2.5",
    "sort-package-json": "^4.1.0",
    "stats-lite": "^2.2.0",
    "stream-json": "^3.7.0",
    "through2-map": "^4.0.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.22.1",
    "npm": ">=10.8.2"
  }
}
